* { box-sizing: border-box; }

body {
  margin: 0;
  background: #f2f2f5;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 16px;
}

.calculator {
  background: #ffffff;
  border-radius: 16px;
  padding: 20px;
  width: 100%;
  max-width: 320px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

#display {
  width: 100%;
  height: 60px;
  font-size: 28px;
  text-align: right;
  border: none;
  border-radius: 10px;
  background: #f2f2f5;
  color: #1a1a1a;
  padding: 0 12px;
  margin-bottom: 14px;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

button {
  padding: 18px 0;
  font-size: 18px;
  border: none;
  border-radius: 10px;
  background: #e9e9ee;
  cursor: pointer;
}

button:active { opacity: 0.7; }

.op { background: #ff9f0a; color: #ffffff; }
.eq { background: #1a1a1a; color: #ffffff; }